# dev-переменные (direnv, если установлен; без него ничего не ломает):
#  direnv allow  — после установки direnv
if [ -f "$HOME/.cache/camoufox-research/config.env" ]; then
  # округ: переменные из единого источника путей
  export CAMOUFOX_REPO="$(sed -n 's/^CAMOUFOX_REPO="\(.*\)"/\1/p' "$HOME/.cache/camoufox-research/config.env")"
  export CAMOUFOX_CACHE_DIR="$(sed -n 's/^CAMOUFOX_CACHE_DIR="\(.*\)"/\1/p' "$HOME/.cache/camoufox-research/config.env")"
fi
# venv-активация (переносимо: python из config.env)
if [ -f "$HOME/.cache/camoufox-research/config.env" ]; then
  source "$(sed -n 's/^CAMOUFOX_PYTHON="\(.*\)"/\1/p' "$HOME/.cache/camoufox-research/config.env" | sed 's|/bin/python||')/activate"
fi
