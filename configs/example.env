# Пример окружения для Camoufox Research (все переменные опциональны).

# venv, которым запускаются скрипты (иначе ~/.venvs/aggg2)
CAMOUFOX_VENV=/home/user/.venvs/my

# Каталог кэша (иначе ~/.cache/camoufox-research)
CAMOUFOX_CACHE_DIR=/home/user/.cache/camoufox-research

# TTL кэша страниц, секунды (по умолчанию 86400 = сутки)
CAMOUFOX_CACHE_TTL=86400

# Таймаут загрузки страницы, секунды (по умолчанию 300)
CAMOUFOX_PAGE_TIMEOUT=300

# Таймаут ожидания контента на JS-страницах, секунды
CAMOUFOX_CONTENT_WAIT=30

# Прокси, если нужен (пусто = без прокси)
CAMOUFOX_PROXY=

# --- Кампании ресёрча (0.8.0) ---
# Куда автоархивировать отчёты кампаний. ПУСТО = research/ рядом с репой
# (переносимо, конвенция research/README.md: YYYY-MM-DD-тема.md,
# отчёты + INDEX.md). Если репо нет рядом — фолбэк exports кэша.
# Явный путь (когда репо в другом месте):
# CAMOUFOX_REPORT_DIR=/путь/к/репе/research
CAMOUFOX_REPORT_DIR=
# Порог «крон сторожа умер» в часах (последний ok старше → предупреждение)
CAMOUFOX_STALE_H=48
# Нестандартный путь к логу сторожа (для скрипта и пульса — один вентиль)
# CAMOUFOX_WATCHDOG_LOG=/home/user/.cache/camoufox-research/watchdog.log

# Куда post_hunt пишет сводку охоты (пусто = ~/.cache/camoufox-research/
# memory.md, файл создаётся сам). Можно указать свою базу заметок.
# CAMOUFOX_MEMORY_FILE=/path/to/my-notes.md
