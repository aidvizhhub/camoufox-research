# Пример окружения для Camoufox Research (все переменные опциональны).

# venv, которым запускаются скрипты (иначе ~/.venvs/aggg2)
CAMOUFOX_VENV=/home/user/.venvs/my

# Каталог кэша (иначе ~/.cache/camoufox-research)
CAMOUFOX_CACHE_DIR=/home/user/.cache/camoufox-research

# TTL кэша страниц, секунды (по умолчанию 86400 = сутки)
CAMOUFOX_CACHE_TTL=86400

# Таймаут загрузки страницы, секунды (по умолчанию 300)
CAMOUFOX_PAGE_TIMEOUT=300

# Таймаут ожидания контента на JS-страницах, секунды
CAMOUFOX_CONTENT_WAIT=30

# Прокси, если нужен (пусто = без прокси)
CAMOUFOX_PROXY=
